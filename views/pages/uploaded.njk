{% extends "templates/base.njk" %}
{% from "../components/nav.njk" import nav %}

{% block head %}
  <title>inside your chest</title>
  <meta property="og:title" content="inside your chest" />
{% endblock %}

{% block body %}
  <div class="account-number">Account: {{ accountNumber }}</div>
  <div class="container">
    <h1>Your Chest</h1>
    <p>Here are all the files you've uploaded.</p>

    <div class="public-grid">
      {% for file in uploads %}
        <div class="file-card" onmouseenter="centerIfNoThumb(this)">
          <a class="file-link" href="/uploads/{{ file.filename }}" target="_blank" title="{{ file.original_filename }}">
            <img class="thumb" src="/uploads/{{ file.filename }}" alt="preview" onerror="this.style.display='none'; this.closest('.file-card').classList.add('no-thumb');" />
            <div class="file-name">{{ file.original_filename }}</div>
          </a>
          <div class="file-meta">
            <div class="file-size">{{ file.size | formatBytes }}</div>
            <div class="file-date">{{ file.create_time | time_format | escape }}</div>
          </div>
          <div class="file-actions">
            <a class="download-btn" href="/uploads/{{ file.filename }}" download>Download</a>
          </div>
        </div>
      {% endfor %}
    </div>
    {{ nav("uploaded") }}
{% endblock %}
